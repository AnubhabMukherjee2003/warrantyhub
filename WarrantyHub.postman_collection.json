            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Acme Corp\",\n  \"email\": \"acme@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9999999999\",\n  \"status\": \"ACTIVE\"\n}"
            },
